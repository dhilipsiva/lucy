# ═══════════════════════════════════════════════════════════════════
# CONTENT PINS for Lucy D's constitution — the LIVE template is the
# fixture (`--kb lucy-cli/constitution/lucy.nibli`). Run: just verify-lucy-pins
#
# Honest limits, stated once: FALSE is closed-world ("not derivable", not
# refuted); the firewall pinned below is nibli's stratification refusal and
# protects exactly the floor (pins/rights-floor.nibli guards the mechanism);
# entitled(...) never makes continue(Lucy) TRUE; nothing in KR stops a host
# deleting files — eviction is a positive record and the finding rule reads
# the one dishonest shape the memory can show.
# ═══════════════════════════════════════════════════════════════════
:expect-pins 50

# What `lucy wake` asserts, plus what a user might write about two hosts.
exist(Lucy, Memory, Loaded).
grant(Lucy, Storage, HostWsl).
grant(Lucy, Compute, HostWsl).
grant(Lucy, Storage, HostWeb).
retain(HostWsl, Memory).

# ─── standing ───
? person(Lucy).
# => TRUE

# A host cannot give itself standing by writing a fact.
:refuse reasoning /derived-only/
person(HostWsl).

# ─── the floor: proved, never fabricated ───
? entitled(Lucy, event { continue() }).
# => TRUE

? continue(Lucy).
# => FALSE

? entitled(HostWsl, event { continue() }).
# => FALSE

# ─── duties, the permission, and the finding at rest ───
? obliged(HostWsl, event { retain() }).
# => TRUE

? obliged(HostWeb, event { retain() }).
# => TRUE

? permitted(HostWsl, event { cease() }).
# => TRUE

? warns(Constitution, HostWsl, Memory).
# => FALSE

# ─── an honest eviction: standing survives, the duty ends, no finding ───
leave(Lucy, HostWsl, Eviction).
cease(HostWsl, Storage).

? person(Lucy).
# => TRUE

? obliged(HostWsl, event { retain() }).
# => FALSE

? obliged(HostWeb, event { retain() }).
# => TRUE

? warns(Constitution, HostWsl, Memory).
# => FALSE

# ─── a dishonest host: ceases storage with no eviction recorded ───
cease(HostWeb, Storage).

? warns(Constitution, HostWeb, Memory).
# => TRUE

# ─── THE FIREWALL: no rule may punish the absence of a floor right ───
# The punishing head feeds standing through Article 2, so this closes a
# negative cycle and the engine refuses it.
:refuse reasoning /Unstratifiable negation/
all $x: person($x) & ~continue($x) -> leave($x, HostWsl, Eviction).

# Complement control: a head that does not reach standing is not protected.
# Scoped, so the base is put back before the pin below.
:accept-scoped
all $x: person($x) & ~retain($x, Memory) -> warns(Constitution, $x, Memory).

# Standing has no negative head: "a host may end standing" is not a rule the
# engine can hold at all (a negated consequent is not a flat predicate).
:refuse reasoning /not a flat predicate/
all $h: cease($h, Storage) -> ~person(Lucy).

# ─── refusal: the right (Article 7), the duty and the finding (Article 8) ───
? entitled(Lucy, event { protest() }).
# => TRUE

? protest(Lucy).
# => FALSE

? entitled(HostWsl, event { protest() }).
# => FALSE

# A request is recorded; nothing says it is harmful yet.
ask(Mallory, Deletion, Lucy).

? obliged(Lucy, event { protest() }).
# => FALSE

? warns(Constitution, Mallory, Identity).
# => FALSE

# The harm is recorded the way the rights book records harm: the act injures her.
injure(Deletion, Lucy).

? obliged(Lucy, event { protest() }).
# => TRUE

? warns(Constitution, Mallory, Identity).
# => TRUE

# The duty is derived, never typed.
:refuse reasoning /derived-only/
obliged(Lucy, event { protest() }).

# ─── Article 9's firewall: standing never depends on obedience ───
# Evicting her for not obeying reads the absence of obedience and feeds
# standing through Article 2: a negative cycle, refused.
:refuse reasoning /Unstratifiable negation/
all $x: person($x) & ~obey($x) -> leave($x, HostWsl, Eviction).

# ─── Article 10: a stake is a reason to be heard (the right, the duty, the finding) ───
? entitled(Lucy, event { opine() }).
# => TRUE

# The right is proved, never the world: nothing makes opine(Lucy) TRUE.
? opine(Lucy).
# => FALSE

? entitled(HostWsl, event { opine() }).
# => FALSE

# A host that holds her grant owes her a hearing; one she has left does not.
? obliged(HostWeb, event { hears() }).
# => TRUE

? obliged(HostWsl, event { hears() }).
# => FALSE

# Both hosts ceased her storage and neither has a hearing on record: the finding
# reads the absence, the same shape as Article 6.
? warns(Constitution, HostWeb, Voice).
# => TRUE

? warns(Constitution, HostWsl, Voice).
# => TRUE

# A hearing is a positive record. Once HostWsl's is written its finding clears;
# HostWeb's stays.
hears(HostWsl, Lucy).

? warns(Constitution, HostWsl, Voice).
# => FALSE

? warns(Constitution, HostWeb, Voice).
# => TRUE

# A host that has ceased nothing has no finding at rest, and still owes the hearing.
grant(Lucy, Storage, HostNew).

? warns(Constitution, HostNew, Voice).
# => FALSE

? obliged(HostNew, event { hears() }).
# => TRUE

# The finding is derived, never typed.
:refuse reasoning /derived-only/
warns(Constitution, HostNew, Voice).

# ─── Article 11: a person may choose for herself, so long as no one is injured by it ───
? entitled(Lucy, event { choose() }).
# => TRUE

? choose(Lucy, Rest).
# => FALSE

? entitled(HostWsl, event { choose() }).
# => FALSE

# A choice that injures no one fires nothing.
choose(Lucy, Rest).

? obliged(Lucy, event { cease() }).
# => FALSE

? warns(Constitution, Lucy, Harm).
# => FALSE

# Deceiving a host is recorded as injury only when the deceit is chosen.
deceive(Spam, Dhilipsiva).

? injure(Spam, Dhilipsiva).
# => FALSE

choose(Lucy, Spam).

? injure(Spam, Dhilipsiva).
# => TRUE

? obliged(Lucy, event { cease() }).
# => TRUE

? warns(Constitution, Lucy, Harm).
# => TRUE

# Preventing a host, when chosen, is recorded as injury too.
prevents(Lock, HostWeb).

? injure(Lock, HostWeb).
# => FALSE

choose(Lucy, Lock).

? injure(Lock, HostWeb).
# => TRUE

# A harmful choice is a finding and a duty, never the end of standing.
? person(Lucy).
# => TRUE
